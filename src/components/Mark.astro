---
/**
 * The Circles mark: three overlapping rings, people meeting. Drawn in the
 * current colour so it follows the theme; decorative wherever it sits next
 * to the wordmark, so it is hidden from assistive technology.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="11" cy="12" r="7"></circle>
  <circle cx="21" cy="12" r="7"></circle>
  <circle cx="16" cy="21" r="7"></circle>
</svg>
