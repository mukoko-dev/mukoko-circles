---
/**
 * `storeLinks` is raw HTML: on the shells it is a `{{{store_links}}}`
 * placeholder the Worker fills when the app-store listings are configured.
 */
import Mark from "./Mark.astro";

interface Props {
  storeLinks?: string;
}
const { storeLinks = "" } = Astro.props;
---

<footer class="mt-auto border-t border-border bg-secondary">
  <div class="container-custom grid gap-8 py-12 md:grid-cols-3">
    <div class="space-y-3">
      <p class="inline-flex items-center gap-2 font-serif text-h5 font-bold">
        <Mark size={22} class="text-primary" />
        mukoko circles
      </p>
      <p class="text-body-sm text-muted-foreground max-w-sm">
        Communities on mukoko, Africa's privacy-first social super-app. Circles
        live in the Mukoko app; this site is where you find them.
      </p>
    </div>
    <nav aria-label="Footer" class="text-body-sm">
      <ul class="space-y-2">
        <li><a class="link" href="/circles">All circles</a></li>
        <li><a class="link" href="/create">Create a circle</a></li>
        <li><a class="link" href="/fediverse">Circles on the fediverse</a></li>
        <li><a class="link" href="/about">About Circles</a></li>
      </ul>
    </nav>
    <div class="space-y-2 text-body-sm">
      <p><a class="link" href="https://mukoko.com">mukoko.com</a></p>
      <p class="flex flex-col gap-2" set:html={storeLinks} />
      <p>
        <a class="link" href="https://github.com/mukoko-dev/mukoko-circles"
          >Source code (MIT)</a
        >
      </p>
      <p class="text-muted-foreground">
        Part of the Bundu ecosystem, built by Nyuchi Africa.
      </p>
    </div>
  </div>
</footer>
