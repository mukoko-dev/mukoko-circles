---
/**
 * TODO(mzizi): https://github.com/mzizi-dev/mzizi-registry/pull/450
 * @bundu/ui 0.3.0 on npm does not ship the Discover detail pattern
 * (mzizi-dev/mzizi-registry#429 / #430; on mzizi-dev/packages-npm `staging`,
 * unreleased), and its MetaList 1.0.0 is not a valid <dl> (axe
 * definition-list / dlitem). This is the registry's
 * `discover-meta-list.astro` with the fix in #450 (contract 1.1.0): each row
 * is <div><dt><dd></div> with the icon in the <dt>, and a row with an empty
 * value hides itself. Imports use package paths. Delete this file and import
 * `@bundu/ui/discover/MetaList.astro` once a release with #450 is installed.
 */
/**
 * MetaList — the facts of one item on its Discover page ("When", "Where",
 * "Price", "Organiser"): a <dl> of label and value rows. A row may carry an
 * icon (the design system's set, decorative), link its value (`href`), or
 * make it a machine-readable time (`datetime`, as <time>).
 *
 * One column on phones; `columns` from 40rem (2) and 64rem (3). Values wrap
 * rather than overflow. Every text is a plain string and an empty value
 * hides its row's value (`empty:hidden`), so a server-filled shell can use
 * it with `{{placeholders}}`. No items, nothing rendered.
 *
 * Mzizi Discover Standard (contracts/discover/meta-list).
 */
import { cn } from "@bundu/ui/lib/utils";
import Icon from "@bundu/ui/Icon.astro";
import type { ComponentProps } from "astro/types";

type IconName = ComponentProps<typeof Icon>["name"];

interface Item {
  label: string;
  value: string;
  /** A glyph from the design system's set; decorative. */
  icon?: IconName;
  /** Links the value (a map, a profile, a source). */
  href?: string;
  /** ISO 8601: the value is a <time datetime>. */
  datetime?: string;
}
interface Props {
  items: Item[];
  /** Columns from 40rem (2) and 64rem (3); 1 keeps one column. */
  columns?: 1 | 2 | 3;
}
const { items, columns = 2 } = Astro.props;
const cols = { 1: "", 2: "sm:grid-cols-2", 3: "sm:grid-cols-2 lg:grid-cols-3" }[columns];
const link = "inline-flex min-h-6 items-center text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground pointer-coarse:min-h-11";
---

{
  items.length > 0 && (
    <dl class={cn("grid gap-x-8 gap-y-5", cols)} data-slot="meta-list" data-columns={columns}>
      {items.map((item) => (
        <div class="min-w-0 has-[dd:empty]:hidden" data-slot="meta-list-item">
          <dt class="flex items-center gap-2 text-caption font-semibold uppercase tracking-wider text-muted-foreground">
            {item.icon !== undefined && <Icon name={item.icon} class="shrink-0 text-body-lg text-muted-foreground" />}
            {item.label}
          </dt>
          <dd class="mt-1 text-body break-words text-foreground empty:hidden">
              {item.href !== undefined ? (
                <a class={link} href={item.href}>
                  {item.datetime !== undefined ? <time datetime={item.datetime}>{item.value}</time> : item.value}
                </a>
              ) : item.datetime !== undefined ? (
                <time datetime={item.datetime}>{item.value}</time>
              ) : (
                item.value
              )}
          </dd>
        </div>
      ))}
    </dl>
  )
}
