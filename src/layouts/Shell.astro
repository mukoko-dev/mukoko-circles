---
/**
 * The page shell, on the Mzizi Discover Standard: DiscoverMeta in <head>,
 * DiscoverShell in <body> (skip link, mineral strip, header, main, footer).
 * Only the brand is ours: the Circles mark and wordmark.
 *
 * On the `/tpl/` shells every prop is a `{{placeholder}}` the Worker fills;
 * on the static pages they are real values. `headExtra` and `storeLinks` are
 * raw HTML (JSON-LD, the ActivityPub alternate link, store badges).
 *
 * No scripts and no inline styles: the CSP is `script-src 'none'` and
 * `style-src 'self'`. Dark mode follows the OS through @bundu/ui's
 * color-scheme.css.
 */
import "@fontsource/noto-sans/latin-400.css";
import "@fontsource/noto-sans/latin-ext-400.css";
import "@fontsource/noto-sans/latin-600.css";
import "@fontsource/noto-sans/latin-ext-600.css";
import "@fontsource/noto-serif/latin-700.css";
import "@fontsource/noto-serif/latin-ext-700.css";
import "../styles/global.css";
import DiscoverMeta from "@bundu/ui/discover/DiscoverMeta.astro";
import DiscoverShell from "@bundu/ui/discover/DiscoverShell.astro";
import Mark from "../components/Mark.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  headExtra?: string;
  storeLinks?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = "https://circles.mukoko.com/og/home.png",
  ogType = "website",
  robots = "index, follow",
  headExtra = "",
  storeLinks = "",
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <DiscoverMeta
      title={title}
      description={description}
      canonical={canonical}
      siteName="Mukoko Circles"
      image={ogImage}
      type={ogType}
      robots={robots}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#4B0082" />
    <meta name="color-scheme" content="light dark" />
    <Fragment set:html={headExtra} />
  </head>
  <body>
    <DiscoverShell
      homeLabel="mukoko circles, home"
      nav={[
        { label: "All circles", href: "/circles" },
        { label: "Fediverse", href: "/fediverse" },
        { label: "About", href: "/about" },
      ]}
      footerLinks={[
        { label: "All circles", href: "/circles" },
        { label: "Create a circle", href: "/create" },
        { label: "Circles on the fediverse", href: "/fediverse" },
        { label: "About Circles", href: "/about" },
      ]}
      footerNote="Part of the Bundu ecosystem, built by Nyuchi Africa."
    >
      <Fragment slot="brand">
        <Mark class="text-primary" />
        <span class="font-serif text-h5 font-bold tracking-tight"
          >mukoko <span class="text-primary">circles</span></span
        >
      </Fragment>
      <a slot="action" class="btn-primary h-11 px-5 text-body-sm" href="/create"
        >Create a circle</a
      >
      <slot />
      <Fragment slot="footer">
        <div class="space-y-3">
          <p class="inline-flex items-center gap-2 font-serif text-h5 font-bold">
            <Mark size={22} class="text-primary" />
            mukoko circles
          </p>
          <p class="max-w-sm text-body-sm text-muted-foreground">
            Communities on mukoko, Africa's privacy-first social super-app.
            Circles live in the Mukoko app; this site is where you find them.
          </p>
        </div>
        <div class="space-y-2 text-body-sm">
          <p><a class="link" href="https://mukoko.com">mukoko.com</a></p>
          <p class="flex flex-col gap-2 empty:hidden" set:html={storeLinks} />
          <p>
            <a class="link" href="https://github.com/mukoko-dev/mukoko-circles"
              >Source code (MIT)</a
            >
          </p>
        </div>
      </Fragment>
    </DiscoverShell>
  </body>
</html>
