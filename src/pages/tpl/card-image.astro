---
/**
 * One circle in a grid, with its own image: the Mzizi DiscoverCard, `circle`
 * variant. The Worker uses this fragment when the Nyuchi API sends a safe
 * https `imageUrl`, and card.astro (the monogram) otherwise: a filled shell
 * cannot leave out an `image` prop, and an empty `src` is not an image.
 */
import DiscoverCard from "@bundu/ui/discover/DiscoverCard.astro";
---

<Fragment set:html="<!--fragment-->" />
<DiscoverCard
  variant="circle"
  href="{{href}}"
  title="{{name}}"
  image="{{image}}"
  badge="{{type_label}}"
  badgeTone="{{type_tone}}"
  summary="{{summary}}"
  meta={["{{members}}", "{{categories}}"]}
/>
<Fragment set:html="<!--/fragment-->" />
