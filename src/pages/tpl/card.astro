---
/**
 * One circle in a grid: the Mzizi DiscoverCard, `circle` variant. A
 * fragment: the Worker repeats it per circle and reads only what is between
 * the fragment markers.
 */
import DiscoverCard from "@bundu/ui/discover/DiscoverCard.astro";
---

<Fragment set:html="<!--fragment-->" />
<DiscoverCard
  variant="circle"
  href="{{href}}"
  title="{{name}}"
  initial="{{initial}}"
  badge="{{type_label}}"
  badgeTone="{{type_tone}}"
  summary="{{summary}}"
  meta={["{{members}}", "{{categories}}"]}
/>
<Fragment set:html="<!--/fragment-->" />
