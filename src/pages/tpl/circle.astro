---
/**
 * One circle's public page. The same URL is the circle's ActivityPub actor:
 * the Worker answers `application/activity+json` with the Group actor and
 * everything else with this page.
 */
import Shell from "../../layouts/Shell.astro";
import Section from "@bundu/ui/Section.astro";
---

<Shell
  title="{{title}}"
  description="{{description}}"
  canonical="{{canonical}}"
  ogImage="{{og_image}}"
  ogType="{{og_type}}"
  robots="{{robots}}"
  headExtra="{{{head_extra}}}"
  storeLinks="{{{store_links}}}"
>
  <section class="gradient-showcase border-b border-border">
    <div class="container-custom py-12 md:py-16">
      <nav aria-label="Breadcrumb" class="mb-6 text-body-sm">
        <ol class="flex flex-wrap gap-2">
          <li><a class="link" href="/">Circles</a> <span aria-hidden="true">/</span></li>
          <li aria-current="page">{"{{name}}"}</li>
        </ol>
      </nav>
      <div class="flex flex-col gap-6 md:flex-row md:items-start">
        <span class="avatar size-20 text-h2" aria-hidden="true">{"{{initial}}"}</span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="{{type_class}}">{"{{type_label}}"}</span>
            <span class="badge bg-muted text-foreground">{"{{language}}"}</span>
            <span data-state="{{place_state}}"
              ><span class="when-ok badge bg-muted text-foreground"
                >{"{{place}}"}</span
              ></span
            >
          </div>
          <h1 class="mt-3 font-serif text-h1 text-balance">{"{{name}}"}</h1>
          <p class="mt-4 max-w-2xl whitespace-pre-line text-body-lg text-muted-foreground">
            {"{{summary}}"}
          </p>
          <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-body-sm">
            <div><dt class="sr-only">Members</dt><dd class="font-semibold">{"{{members}}"}</dd></div>
            <div><dt class="sr-only">Posts</dt><dd>{"{{posts}}"}</dd></div>
            <div class="empty-hide"><dt class="sr-only">Started</dt><dd class="empty-hide">{"{{since}}"}</dd></div>
          </dl>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a class="btn-primary" href="{{join_href}}">{"{{join_label}}"}</a>
            <a class="btn-outline" href="/create">Start your own circle</a>
          </div>
          <p class="mt-3 text-body-sm text-muted-foreground">
            {"{{type_hint}}"} Opens in the Mukoko app, or on the web if you don't
            have it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Section space="tight">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2" data-state="{{posts_state}}">
        <h2 class="font-serif text-h3">Recent public posts</h2>
        <ul class="when-ok mt-6 space-y-4">
          <Fragment set:html="{{{posts}}}" />
        </ul>
        <div class="when-empty card mt-6 p-6">
          <p class="text-muted-foreground">
            Conversations in this circle happen in the Mukoko app. Join to see
            them and take part.
          </p>
        </div>
      </div>
      <aside class="space-y-6" aria-label="About this circle">
        <div class="card p-6">
          <h2 class="font-sans text-h5 font-semibold">On the fediverse</h2>
          <p class="mt-3 handle">{"{{handle}}"}</p>
          <p class="mt-3 text-body-sm text-muted-foreground">
            Search for this address in Mastodon or any ActivityPub app to see the
            circle and its public posts. Following from other servers is coming
            soon; for now, join in Mukoko.{" "}
            <a class="link" href="/fediverse">Learn more</a>
          </p>
        </div>
        <div class="card p-6" data-state="{{categories_state}}">
          <h2 class="font-sans text-h5 font-semibold">Categories</h2>
          <ul class="when-ok mt-4 flex flex-wrap gap-2">
            <Fragment set:html="{{{categories}}}" />
          </ul>
          <p class="when-empty mt-3 text-body-sm text-muted-foreground">
            Not in a category yet.{" "}
            <a class="link" href="/circles">See all circles</a>
          </p>
        </div>
      </aside>
    </div>
  </Section>
</Shell>
