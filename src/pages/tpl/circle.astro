---
/**
 * One circle's public page, on the Mzizi Discover detail pattern:
 * DiscoverBreadcrumb and DetailHero at the top, OpenInApp as the one
 * action, MetaList for the facts, then the circle's public posts. The same
 * URL is the circle's ActivityPub actor: the Worker answers
 * `application/activity+json` with the Group actor and everything else with
 * this page. Only public and broadcast circles ever reach it.
 *
 * The breadcrumb's BreadcrumbList JSON-LD comes from the Worker (in
 * `head_extra`, with the rest of the page's JSON-LD), so the component's own
 * is off. A MetaList row whose value fills to "" hides itself (place and
 * start date are optional).
 */
import Shell from "../../layouts/Shell.astro";
import Section from "@bundu/ui/Section.astro";
import OpenInApp from "@bundu/ui/discover/OpenInApp.astro";
import DetailHero from "@bundu/ui/discover/DetailHero.astro";
import DiscoverBreadcrumb from "@bundu/ui/discover/DiscoverBreadcrumb.astro";
import MetaList from "@bundu/ui/discover/MetaList.astro";
---

<Shell
  title="{{title}}"
  description="{{description}}"
  canonical="{{canonical}}"
  ogImage="{{og_image}}"
  ogType="{{og_type}}"
  robots="{{robots}}"
  headExtra="{{{head_extra}}}"
  storeLinks="{{{store_links}}}"
>
  <DetailHero title="{{name}}" eyebrow="{{type_label}} circle" lead="{{summary}}">
    <DiscoverBreadcrumb
      slot="breadcrumb"
      crumbs={[{ label: "Circles", href: "/" }, { label: "{{name}}" }]}
      jsonLd={false}
    />
    <OpenInApp
      slot="actions"
      href="{{join_href}}"
      label="{{join_label}}"
      hint="{{type_hint}} Opens in the Mukoko app, or on the web if you don't have it."
    >
      <a class="btn-outline" href="/create">Start your own circle</a>
    </OpenInApp>
  </DetailHero>

  <Section space="tight">
    <h2 class="sr-only">About this circle</h2>
      <MetaList
        columns={3}
        items={[
          { label: "Members", value: "{{members}}", icon: "users" },
          { label: "Public posts", value: "{{posts}}", icon: "message" },
          { label: "Language", value: "{{language}}", icon: "globe" },
          { label: "Where", value: "{{place}}", icon: "map-pin" },
          { label: "Started", value: "{{since}}", icon: "calendar" },
        ]}
      />
  </Section>

  <Section space="tight">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="group/posts lg:col-span-2" data-state="{{posts_state}}">
        <h2 class="font-serif text-h3">Recent public posts</h2>
        <ul class="mt-6 space-y-4 group-data-[state=empty]/posts:hidden">
          <Fragment set:html="{{{posts}}}" />
        </ul>
        <div class="card mt-6 hidden p-6 group-data-[state=empty]/posts:block">
          <p class="text-muted-foreground">
            Conversations in this circle happen in the Mukoko app. Join to see
            them and take part.
          </p>
        </div>
      </div>
      <aside class="space-y-6" aria-label="More about this circle">
        <div class="card p-6">
          <h2 class="font-sans text-h5 font-semibold">On the fediverse</h2>
          <p class="mt-3 font-mono text-body-sm break-all">{"{{handle}}"}</p>
          <p class="mt-3 text-body-sm text-muted-foreground">
            Search for this address in Mastodon or any ActivityPub app to see the
            circle and its public posts. Following from other servers is coming
            soon; for now, join in Mukoko.{" "}
            <a class="link" href="/fediverse">Learn more</a>
          </p>
        </div>
        <div class="group/cats card p-6" data-state="{{categories_state}}">
          <h2 class="font-sans text-h5 font-semibold">Categories</h2>
          <ul class="mt-4 flex flex-wrap gap-2 group-data-[state=empty]/cats:hidden">
            <Fragment set:html="{{{categories}}}" />
          </ul>
          <p class="mt-3 hidden text-body-sm text-muted-foreground group-data-[state=empty]/cats:block">
            Not in a category yet.{" "}
            <a class="link" href="/circles">See all circles</a>
          </p>
        </div>
      </aside>
    </div>
  </Section>
</Shell>
