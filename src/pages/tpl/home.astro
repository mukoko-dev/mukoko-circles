---
/**
 * The home page shell, on the Mzizi Discover Standard. The Worker fills it
 * from the Nyuchi API: featured circles, the biggest circles, the
 * categories and the count.
 */
import Shell from "../../layouts/Shell.astro";
import DiscoverHero from "@bundu/ui/discover/DiscoverHero.astro";
import DiscoverSearch from "@bundu/ui/discover/DiscoverSearch.astro";
import DiscoverSection from "@bundu/ui/discover/DiscoverSection.astro";
import ResultGrid from "@bundu/ui/discover/ResultGrid.astro";
import CategoryChips from "@bundu/ui/discover/CategoryChips.astro";
import EmptyState from "@bundu/ui/app/EmptyState.astro";
---

<Shell
  title="{{title}}"
  description="{{description}}"
  canonical="{{canonical}}"
  ogImage="{{og_image}}"
  ogType="{{og_type}}"
  robots="{{robots}}"
  headExtra="{{{head_extra}}}"
  storeLinks="{{{store_links}}}"
>
  <DiscoverHero
    size="home"
    eyebrow="Mukoko Circles"
    title="Find your people. Keep them close."
    lead="Circles are communities on mukoko, Africa's privacy-first social super-app: running clubs, fan clubs, neighbourhood groups, professional networks and everything in between. Browse the open ones here, then join in the Mukoko app."
    count="{{total}} on Mukoko"
  >
    <DiscoverSearch
      slot="search"
      id="hero-search"
      label="Search circles"
      placeholder="Search circles: running, Shona, design…"
    />
    <Fragment slot="actions">
      <a class="btn-primary" href="/create">Create a circle</a>
      <a class="btn-outline" href="/circles">Browse all circles</a>
    </Fragment>
  </DiscoverHero>

  <DiscoverSection
    id="featured"
    eyebrow="Featured"
    title="Circles worth joining"
    description="A few of the busiest open circles on Mukoko right now."
  >
    <ResultGrid label="Featured circles" state="{{featured_state}}">
      <Fragment set:html="{{{featured}}}" />
      <EmptyState
        slot="empty"
        title="No open circles yet."
        level={3}
        message="Be the first: start one for your people in the Mukoko app."
      >
        <a class="btn-primary" href="/create">Create a circle</a>
      </EmptyState>
    </ResultGrid>
  </DiscoverSection>

  <DiscoverSection
    id="browse"
    eyebrow="Browse"
    title="Find circles by what you love"
    tone="muted"
    space="tight"
    state="{{categories_state}}"
  >
    <CategoryChips label="Categories">
      <Fragment set:html="{{{categories}}}" />
    </CategoryChips>
  </DiscoverSection>

  <DiscoverSection
    id="latest"
    eyebrow="Open circles"
    title="More circles to explore"
    tone="muted"
    space="tight"
    seeAllHref="/circles"
    seeAllLabel="See every circle"
    state="{{latest_state}}"
  >
    <ResultGrid label="Open circles">
      <Fragment set:html="{{{latest}}}" />
    </ResultGrid>
  </DiscoverSection>

  <DiscoverSection
    id="how"
    eyebrow="How it works"
    title="One home for your communities"
    description="Circles live in the Mukoko super-app, alongside your events, messages and news. This site is the front door."
  >
    <ol class="grid gap-4 md:grid-cols-3">
      <li class="card p-6">
        <p class="badge-premium">1</p>
        <h3 class="mt-4 font-sans text-h5 font-semibold">Find a circle</h3>
        <p class="mt-2 text-body-sm text-muted-foreground">
          Every public and broadcast circle is listed here, by topic, by size
          and by search. Private circles never are.
        </p>
      </li>
      <li class="card p-6">
        <p class="badge-premium">2</p>
        <h3 class="mt-4 font-sans text-h5 font-semibold">Join in Mukoko</h3>
        <p class="mt-2 text-body-sm text-muted-foreground">
          Tap Join and the circle opens in the Mukoko app. Your membership,
          your posts and your privacy settings stay with you there.
        </p>
      </li>
      <li class="card p-6">
        <p class="badge-premium">3</p>
        <h3 class="mt-4 font-sans text-h5 font-semibold">
          Find it from the fediverse
        </h3>
        <p class="mt-2 text-body-sm text-muted-foreground">
          Every open circle has an address, like{" "}
          <span class="font-mono break-all">{"{{example_handle}}"}</span>. Look
          it up from Mastodon or any ActivityPub app.{" "}
          <a class="link" href="/fediverse">How it works</a>
        </p>
      </li>
    </ol>
  </DiscoverSection>

  <DiscoverSection
    id="start"
    title="Start a circle for your people"
    description="Umuntu ngumuntu ngabantu: a person is a person through other people. Bring yours together."
    tone="muted"
    space="tight"
    seeAllHref="/create"
    seeAllLabel="Create a circle"
  />
</Shell>
