---
/**
 * The shell for every list: all circles, a category, search results. On the
 * Mzizi Discover Standard: hero with search, a ResultGrid with cursor
 * "load more", then the categories.
 */
import Shell from "../../layouts/Shell.astro";
import Section from "@bundu/ui/Section.astro";
import DiscoverHero from "@bundu/ui/discover/DiscoverHero.astro";
import DiscoverSearch from "@bundu/ui/discover/DiscoverSearch.astro";
import DiscoverSection from "@bundu/ui/discover/DiscoverSection.astro";
import ResultGrid from "@bundu/ui/discover/ResultGrid.astro";
import LoadMore from "@bundu/ui/discover/LoadMore.astro";
import CategoryChips from "@bundu/ui/discover/CategoryChips.astro";
import EmptyState from "@bundu/ui/app/EmptyState.astro";
---

<Shell
  title="{{title}}"
  description="{{description}}"
  canonical="{{canonical}}"
  ogImage="{{og_image}}"
  ogType="{{og_type}}"
  robots="{{robots}}"
  headExtra="{{{head_extra}}}"
  storeLinks="{{{store_links}}}"
>
  <DiscoverHero
    crumbs={[{ label: "Circles", href: "/" }, { label: "{{heading}}" }]}
    eyebrow="{{eyebrow}}"
    title="{{heading}}"
    lead="{{lead}}"
  >
    <DiscoverSearch
      slot="search"
      id="list-search"
      label="Search circles"
      q="{{q}}"
      placeholder="Search circles: running, Shona, design…"
    />
  </DiscoverHero>

  <Section space="tight">
    <ResultGrid label="Circles" state="{{results_state}}" summary="{{results}}">
      <Fragment set:html="{{{cards}}}" />
      <EmptyState
        slot="empty"
        title="No circles here yet."
        message="Try another search, or start the circle you were looking for."
      >
        <a class="btn-primary" href="/create">Create a circle</a>
        <a class="btn-outline" href="/circles">All circles</a>
      </EmptyState>
      <LoadMore
        slot="more"
        href="{{next_href}}"
        state="{{more_state}}"
        label="More circles"
      />
    </ResultGrid>
  </Section>

  <DiscoverSection
    id="browse"
    title="Browse by category"
    tone="muted"
    space="tight"
    level={2}
  >
    <CategoryChips label="Categories">
      <Fragment set:html="{{{categories}}}" />
    </CategoryChips>
  </DiscoverSection>
</Shell>
